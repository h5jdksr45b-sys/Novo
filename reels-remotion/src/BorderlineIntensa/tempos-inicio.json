  {
   "t0": 1.303,
   "t1": 4.734,
   "txt": "Borderline, a intensa,"
  },
  {
   "t0": 4.734,
   "t1": 8.245,
   "txt": "sentindo mais uma rodada"
  },
  {
   "t0": 8.245,
   "t1": 10.08,
   "txt": "Me chamaram de exagero,"
  },
  {
   "t0": 10.08,
   "t1": 12.074,
   "txt": "hoje eu sei o que me excede"
  },
  {
   "t0": 12.074,
   "t1": 13.75,
   "txt": "Só fica do meu lado"
  },
  {
   "t0": 13.75,
   "t1": 15.585,
   "txt": "quem respeita quando eu pede"
  },
  {
   "t0": 15.585,
   "t1": 17.5,
   "txt": "Nas antiga era explosão,"
  },
  {
   "t0": 17.5,
   "t1": 19.175,
   "txt": "era grito, era queixa"
  },
  {
   "t0": 19.175,
   "t1": 20.931,
   "txt": "Hoje eu dou nome à emoção"
  },
  {
   "t0": 20.931,
   "t1": 23.165,
   "txt": "antes de subir na parede"
  },
  {
   "t0": 23.165,
   "t1": 25.0,
   "txt": "Sou intensa de fábrica,"
  },
  {
   "t0": 25.0,
   "t1": 26.675,
   "txt": "rainha da avalanche"
  }
