{
 "linhas": [
  {
   "t0": 0.413,
   "t1": 2.248,
   "txt": "Se desmarca nosso encontro,"
  },
  {
   "t0": 2.248,
   "t1": 4.004,
   "txt": "já me vejo andar na prancha"
  },
  {
   "t0": 4.004,
   "t1": 5.919,
   "txt": "Dois anos de terapia"
  },
  {
   "t0": 5.919,
   "t1": 7.754,
   "txt": "pra sair dessa balança"
  },
  {
   "t0": 7.754,
   "t1": 9.589,
   "txt": "Por isso que nós respira,"
  },
  {
   "t0": 9.589,
   "t1": 11.424,
   "txt": "por isso que nós descansa"
  },
  {
   "t0": 11.424,
   "t1": 13.02,
   "txt": "Dá pra pagar um aluguel"
  },
  {
   "t0": 13.02,
   "t1": 15.334,
   "txt": "só com meu gasto de repente"
  },
  {
   "t0": 15.334,
   "t1": 16.929,
   "txt": "É o bonde das intensas,"
  },
  {
   "t0": 16.929,
   "t1": 18.764,
   "txt": "só patroa consciente"
  },
  {
   "t0": 18.764,
   "t1": 20.6,
   "txt": "Brinde com chá de cidreira,"
  },
  {
   "t0": 20.6,
   "t1": 22.435,
   "txt": "meu diário vai na frente"
  },
  {
   "t0": 22.435,
   "t1": 24.27,
   "txt": "Muito cuidado comigo"
  },
  {
   "t0": 24.27,
   "t1": 26.105,
   "txt": "que eu sinto em alta corrente"
  }
 ],
